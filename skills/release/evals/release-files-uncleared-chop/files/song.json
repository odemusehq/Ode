{
  "version": 1,
  "title": "Tin Roof Weather",
  "intent": {
    "theme": "holding on to someone for one more rainy day",
    "story": "Two people wait out a storm in a small house; one of them leaves when the roads dry, and the singer quietly hopes the rain won't stop",
    "pointOfView": "first person, singing to the one who is leaving",
    "mood": "warm, wistful, unhurried",
    "hook": "Drum, drum on the tin roof"
  },
  "settings": {},
  "lyrics": "[Verse 1]\nThe kettle clicks, the windows fog\nYou trace a road across the glass\nYour bag has waited by the door\nSince the first warm day of March\n\n[Chorus 1]\nSo drum, drum on the tin roof\nKeep the roads too wet to leave\nEvery cloud that stalls above us\nBuys another night for me\n\n[Verse 2]\nThe radio says the skies will clear\nI turn it down and pour the tea\nYou laugh the way you used to laugh\nBefore the maps got hold of you\n\n[Chorus 2]\nSo drum, drum on the tin roof\nKeep the roads too wet to leave\nEvery cloud that stalls above us\nBuys another night for me\n\n[Outro]\nDrum, drum on the tin roof\nDon't let up till morning",
