{
  "name": "ode",
  "version": "0.1.0",
  "private": true,
  "description": "Ode: an AI co-writer and co-producer inside Ableton Live.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "build": "npm run build:ui && npm run build:extension && npm run build:device",
    "build:ui": "vite build",
    "build:extension": "tsx src/live/extension/build.ts",
    "build:device": "tsx src/live/device/build.ts",
    "live:extension": "tsx src/live/extension/run.ts",
    "bridge:install": "tsx src/live/bridge/install.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"src/tests/**/*.test.ts\"",
    "test:skills": "tsx src/tests/skill-scenarios.ts",
    "release:package": "tsx src/packaging/package.ts",
    "release:notes": "tsx src/packaging/notes.ts",
    "preversion": "npm run typecheck && npm test",
    "version": "tsx src/packaging/version.ts && git add src/live/extension/manifest.json",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@fal-ai/client": "^1.10.1",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "dotenv": "^18.0.9",
    "fft.js": "^4.0.4",
    "hono": "^4.13.14",
    "hyphen": "^1.14.1",
    "node-diff3": "^3.2.1",
    "openai": "^7.45.1",
    "sharp": "^0.35.5",
    "tonal": "^6.5.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
