# Settings for working on Ode from its source. Copy this file to .env, which stays on your machine.
# Musicians install Ode.ablx and set everything in Ode: Settings; this file is for developers.
#
# Rights: Ode is used to make songs for release. Only choose models and services whose terms allow commercial use
# and leave the musician all rights to what they make (no ownership, attribution or revenue claims over the results).

# The Live app that runs the Ode extension during development (extensions currently need the Live beta).
# On Windows: "C:/ProgramData/Ableton/Live 12 Beta/Program/Ableton Live 12 Beta.exe"
ODE_LIVE_APP="/Applications/Ableton Live 12 Beta.app"
# Stands in for the extension's storage folder when Ode's tools run outside Live (npm run test:skills):
# your own Settings, as settings.json, go here.
ODE_USER_DIR=~/Music/Ode
# Ode's local server while the extension runs in Live (it prints the address when it starts), for the UI's
# development server (npx vite). Leave it empty otherwise.
ODE_DEV_SERVER=

# Local development credentials. Import them into ODE_USER_DIR/settings.json with npm run settings:import.
# Keep .env private; installed Ode still uses its own persistent Settings, not this file.
# Meta key from https://dev.meta.ai, used for listening, transcription and the default Meta chat provider.
META_API_KEY=
# Optional alternate chat provider. Keep meta to use META_API_KEY for chat too.
ODE_CHAT_PROVIDER=meta
ODE_CHAT_MODEL=muse-wonder-1.0
# Only fill this when choosing another supported chat provider, such as baseten or modal.
ODE_CHAT_API_KEY=
