# Ode configuration. Copy this file to .env and fill in your keys. Never commit .env.
#
# Rights: Ode is used to make songs for release. Only configure models and services whose terms allow
# commercial use and leave the musician all rights to what they make (no ownership, attribution or revenue
# claims over the results).

# ─── Local server ────────────────────────────────────────────────────────────
ODE_HOST=127.0.0.1
ODE_PORT=8747
# Port of the Python bridge inside Live (loads plugins, presets and samples from Live's browser).
ODE_BRIDGE_PORT=9878
# Where Ode keeps what it knows about the artist, settings and unsaved songs.
ODE_USER_DIR=~/Music/Ode
# The Live app that runs the Ode extension during development (extensions currently need the Live beta).
# On Windows: "C:/ProgramData/Ableton/Live 12 Beta/Program/Ableton Live 12 Beta.exe"
ODE_LIVE_APP="/Applications/Ableton Live 12 Beta.app"
# Your Ableton User Library: the Ode device is installed under Presets, the Python bridge under Remote Scripts.
# Ode reads the line for the system it runs on; both hold Live's default folder.
ODE_ABLETON_USER_LIBRARY_MACOS="~/Music/Ableton/User Library"
ODE_ABLETON_USER_LIBRARY_WINDOWS="~/Documents/Ableton/User Library"

# ─── Meta Model API ──────────────────────────────────────────────────────────
# One key for every role whose provider is "meta". Get it at https://dev.meta.ai
META_API_KEY=

# ─── Model roles ─────────────────────────────────────────────────────────────
# Each part of Ode uses a role: provider + endpoint + key + model.
# Leave a role's API_KEY empty to use META_API_KEY when its provider is "meta".

# Main agent: conversation, planning, decisions.
# The agent runtime (Claude Agent SDK) needs an Anthropic Messages-compatible endpoint.
ODE_MAIN_PROVIDER=meta
ODE_MAIN_BASE_URL=https://api.meta.ai
ODE_MAIN_API_KEY=
ODE_MAIN_MODEL=muse-wonder-1.0
# Alternatives:
#   Anthropic:  ODE_MAIN_PROVIDER=anthropic   ODE_MAIN_BASE_URL=https://api.anthropic.com  ODE_MAIN_MODEL=claude-opus-5-5
#   OpenRouter: ODE_MAIN_PROVIDER=openrouter  ODE_MAIN_BASE_URL=https://openrouter.ai/api  ODE_MAIN_MODEL=<vendor>/<model>
#   Any other provider: run a LiteLLM proxy and point ODE_MAIN_BASE_URL at it.

# Subagents started by the main agent.
# They use the same endpoint and key as the main agent (the agent runtime talks to one endpoint); only the model differs.
ODE_SUBAGENT_MODEL=muse-spark-1.3
# Alternatives: any model served by the main endpoint, e.g. claude-sonnet-5-5 on Anthropic.

# Audio understanding: what is in a recording, spoken instructions.
ODE_AUDIO_UNDERSTANDING_PROVIDER=meta
ODE_AUDIO_UNDERSTANDING_BASE_URL=https://api.meta.ai/v1
ODE_AUDIO_UNDERSTANDING_API_KEY=
ODE_AUDIO_UNDERSTANDING_MODEL=muse-spark-1.2
# Alternatives (OpenAI-compatible, audio-capable model):
#   OpenAI:     ODE_AUDIO_UNDERSTANDING_PROVIDER=openai      ODE_AUDIO_UNDERSTANDING_BASE_URL=https://api.openai.com/v1
#   OpenRouter: ODE_AUDIO_UNDERSTANDING_PROVIDER=openrouter  ODE_AUDIO_UNDERSTANDING_BASE_URL=https://openrouter.ai/api/v1

# Transcription: sung or spoken words to text.
ODE_TRANSCRIPTION_PROVIDER=meta
ODE_TRANSCRIPTION_BASE_URL=https://api.meta.ai/v1
ODE_TRANSCRIPTION_API_KEY=
ODE_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
# Alternatives (OpenAI-compatible /audio/transcriptions):
#   OpenAI, Groq or a local Whisper server: ODE_TRANSCRIPTION_PROVIDER=openai  ODE_TRANSCRIPTION_BASE_URL=<…/v1>  ODE_TRANSCRIPTION_MODEL=<model>

# Image generation: cover art.
ODE_IMAGE_GENERATION_PROVIDER=meta
ODE_IMAGE_GENERATION_BASE_URL=https://api.meta.ai/v1
ODE_IMAGE_GENERATION_API_KEY=
ODE_IMAGE_GENERATION_MODEL=muse-image-1.0
# Alternatives (OpenAI-compatible /images/generations): ODE_IMAGE_GENERATION_PROVIDER=openai  ODE_IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1

# Stem separation: isolating a described sound ("the guitar", "the voice") from a recording,
# with a text-prompted source separation model.
# Providers Ode supports:
#   fal          a model hosted on fal (BASE_URL=https://fal.run, MODEL=<fal model id>)
#   self-hosted  your own server implementing POST {BASE_URL}/separate (see src/services/adapters/self-hosted.ts)
ODE_STEM_SEPARATION_PROVIDER=
ODE_STEM_SEPARATION_BASE_URL=
ODE_STEM_SEPARATION_API_KEY=
ODE_STEM_SEPARATION_MODEL=

# Singing voice: a demo vocal of the lyrics on the melody, sung in the artist's own voice, with a
# singing voice synthesis model that reproduces a voice from a short recording.
# Ode only uses a recording of the artist's voice after they give consent (voice_reference_set).
# Providers Ode supports:
#   self-hosted  your own server implementing POST {BASE_URL}/sing (see src/services/adapters/self-hosted.ts)
ODE_SINGING_VOICE_PROVIDER=
ODE_SINGING_VOICE_BASE_URL=
ODE_SINGING_VOICE_API_KEY=
ODE_SINGING_VOICE_MODEL=

# Sound generation: sounds and one-shots from a description, with a text-to-audio model.
# Providers Ode supports:
#   elevenlabs   ElevenLabs sound effects (BASE_URL=https://api.elevenlabs.io, MODEL=<model id>)
#   self-hosted  your own server implementing POST {BASE_URL}/sound (see src/services/adapters/self-hosted.ts)
ODE_SOUND_GENERATION_PROVIDER=
ODE_SOUND_GENERATION_BASE_URL=
ODE_SOUND_GENERATION_API_KEY=
ODE_SOUND_GENERATION_MODEL=

# ─── Live connections ────────────────────────────────────────────────────────
# Seconds to wait for Live to answer an operation, and for long ones (rendering audio, measuring the Master).
ODE_LIVE_TIMEOUT_SECONDS=15
ODE_LIVE_LONG_TIMEOUT_SECONDS=300

# ─── Memory ──────────────────────────────────────────────────────────────────
# Things Ode noticed (not things you said) fade by half over this many days, so old habits don't harden.
ODE_MEMORY_HALF_LIFE_DAYS=180
# Size limit of the summary of you and the song that Ode gives the model before each request.
ODE_SUMMARY_MAX_CHARS=2000
# Size limit of the compact map of the whole project sent with every request (details come from the tools).
ODE_MAP_MAX_CHARS=24000

# ─── Version history ─────────────────────────────────────────────────────────
# A full snapshot of the Set is stored every this many versions, so restoring an old version stays fast.
ODE_VERSION_SNAPSHOT_EVERY=20
# History groups consecutive versions by the same author made within this many minutes.
ODE_VERSION_GROUP_MINUTES=10

# ─── Release ─────────────────────────────────────────────────────────────────
# How many cover art images Ode makes for you to pick from.
ODE_COVER_ART_CHOICES=4

# ─── Agent limits ────────────────────────────────────────────────────────────
# How deep subagents can start their own subagents, how many run at once, and a spending cap per request.
ODE_SUBAGENT_DEPTH=2
ODE_SUBAGENTS_AT_ONCE=6
ODE_BUDGET_USD_PER_REQUEST=3
